{
  "name": "@juanarenas312002/ams-ui",
  "version": "0.3.1",
  "description": "Librería de componentes de AMS, el sistema de gestión académica: React, Tailwind CSS v4 y Radix.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwindcss",
    "radix",
    "ams"
  ],
  "homepage": "https://github.com/JuanArenas2002/AMS-UI#readme",
  "bugs": {
    "url": "https://github.com/JuanArenas2002/AMS-UI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuanArenas2002/AMS-UI.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./tokens.css": "./dist-lib/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "preview": "vite preview",
    "a11y": "node scripts/a11y.mjs",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/styles/tokens.css','dist-lib/tokens.css')\"",
    "smoke": "node scripts/lib-smoke.mjs",
    "check:release": "npm run check && npm run build:lib && npm run smoke && npm run a11y",
    "prepublishOnly": "npm run check:release"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react-hook-form": "^7.90.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
