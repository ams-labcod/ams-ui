  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && vite build",
    "preview": "vite preview",
    "a11y": "node scripts/a11y.mjs",
    "build:lib": "node scripts/generar-entradas.mjs && vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/styles/tokens.css','dist-lib/tokens.css')\"",
    "smoke": "node scripts/lib-smoke.mjs",
    "check:release": "npm run check && npm run build:lib && npm run smoke && npm run a11y",
    "prepublishOnly": "npm run check:release",
    "entradas": "node scripts/generar-entradas.mjs"
  },
